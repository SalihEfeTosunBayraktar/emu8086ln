<UserControl x:Class="Emu8086.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Emu8086.App.Services"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit">
    <DockPanel>
        <!-- Find / replace bar (Ctrl+F, Ctrl+H) -->
        <Border x:Name="FindBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="8,6"
                Background="{DynamicResource Bg.Panel2}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="FindBox" KeyDown="OnFindKeyDown" TextChanged="OnFindTextChanged"
                         ToolTip="{svc:Tr find.find}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Style="{StaticResource ToolButton}" Click="OnFindPrevious" ToolTip="{svc:Tr find.previous}">
                        <Path Data="M6,15 L12,9 L18,15" Style="{StaticResource Icon}" Width="12" Height="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnFindNext" ToolTip="{svc:Tr find.next}">
                        <Path Data="M6,9 L12,15 L18,9" Style="{StaticResource Icon}" Width="12" Height="12"/>
                    </Button>
                    <CheckBox x:Name="MatchCase" Content="Aa" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="{svc:Tr find.matchCase}" Click="OnFindTextChanged"/>
                    <CheckBox x:Name="WholeWord" Content="[ab]" Margin="10,0,0,0" VerticalAlignment="Center"
                              ToolTip="{svc:Tr find.wholeWord}" Click="OnFindTextChanged"/>
                </StackPanel>
                <TextBlock x:Name="FindStatus" Grid.Column="2" Margin="12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg.Muted}"/>
                <Button Grid.Column="3" Style="{StaticResource ToolButton}" Click="OnCloseFind">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="10" Height="10"/>
                </Button>

                <TextBox x:Name="ReplaceBox" Grid.Row="1" Margin="0,6,0,0" KeyDown="OnReplaceKeyDown"
                         ToolTip="{svc:Tr find.replace}"/>
                <StackPanel x:Name="ReplaceButtons" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="6,6,0,0">
                    <Button Content="{svc:Tr find.replaceOne}" Padding="10,3" Click="OnReplaceOne"/>
                    <Button Content="{svc:Tr find.replaceAll}" Padding="10,3" Margin="6,0,0,0" Click="OnReplaceAll"/>
                </StackPanel>
            </Grid>
        </Border>

        <avalon:TextEditor x:Name="Editor"
                           Background="{DynamicResource Bg.Editor}"
                           Foreground="{DynamicResource Fg.Primary}"
                           LineNumbersForeground="{DynamicResource Fg.Muted}"
                           HorizontalScrollBarVisibility="Auto"
                           VerticalScrollBarVisibility="Auto"
                           Padding="6,4,0,0"/>
    </DockPanel>
</UserControl>
