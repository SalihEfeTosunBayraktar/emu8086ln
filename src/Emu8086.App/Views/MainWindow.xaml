<Window x:Class="Emu8086.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Emu8086.App.Services"
        xmlns:inf="clr-namespace:Emu8086.App.Infrastructure"
        xmlns:vm="clr-namespace:Emu8086.App.ViewModels"
        xmlns:views="clr-namespace:Emu8086.App.Views"
        xmlns:ctl="clr-namespace:Emu8086.App.Controls"
        Title="{Binding WindowTitle}"
        Width="1500" Height="900" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico"
        Background="{DynamicResource Bg.Window}"
        Foreground="{DynamicResource Fg.Primary}"
        FontFamily="{StaticResource Font.UI}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <inf:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <inf:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <inf:NullToVisibilityConverter x:Key="NullToVis"/>
        <inf:NullToVisibilityConverter x:Key="InvNullToVis" Invert="True"/>
        <inf:LocKeyConverter x:Key="LocKey"/>
        <inf:CountToVisibilityConverter x:Key="CountToVis"/>
        <inf:StatusBrushConverter x:Key="StatusBrush"/>
        <inf:SeverityIconConverter x:Key="SeverityIcon"/>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="6,8"/>
            <Setter Property="Background" Value="{DynamicResource Border}"/>
        </Style>

        <Style x:Key="RegisterBox" TargetType="TextBox" BasedOn="{StaticResource MonoBox}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1,1"/>
            <Setter Property="Margin" Value="1,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Changed}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Changed}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}"/>
        <KeyBinding Key="F4" Modifiers="Control" Command="{Binding CloseDocumentCommand}"/>
        <KeyBinding Key="F7" Command="{Binding BuildCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RunCommand}"/>
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding StopCommand}"/>
        <KeyBinding Key="F6" Command="{Binding PauseCommand}"/>
        <KeyBinding Key="F11" Command="{Binding StepIntoCommand}"/>
        <KeyBinding Key="F10" Command="{Binding StepOverCommand}"/>
        <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding StepBackCommand}"/>
        <KeyBinding Key="F10" Modifiers="Control" Command="{Binding RunToCursorCommand}"/>
        <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}"/>
    </Window.InputBindings>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ===================== Title bar with menu ===================== -->
            <Grid Grid.Row="0" Background="{DynamicResource Bg.Window}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="12,0,6,0" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="6" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="/Assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="emu8086ln" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Menu Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <MenuItem Header="{svc:Tr menu.file}">
                        <MenuItem Header="{svc:Tr cmd.newProject}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Project}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.openProject}" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Folder}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RecentMenu" Header="{svc:Tr cmd.recent}" ItemsSource="{Binding RecentProjects}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{svc:Tr cmd.newFile}" Command="{Binding NewFileCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.New}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.openFile}" Command="{Binding OpenFileCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.File}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.openExecutable}" Command="{Binding OpenExecutableCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Chip}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.save}" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Save}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.saveAll}" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S"/>
                        <MenuItem Header="{svc:Tr cmd.closeFile}" Command="{Binding CloseDocumentCommand}" InputGestureText="Ctrl+F4"/>
                        <Separator/>
                        <MenuItem Header="{svc:Tr cmd.exportListing}" Command="{Binding ExportListingCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.File}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.export}" Command="{Binding ExportCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Export}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{svc:Tr cmd.exit}" Click="OnExitClick"/>
                    </MenuItem>
                    <MenuItem Header="{svc:Tr menu.run}">
                        <MenuItem Header="{svc:Tr cmd.build}" Command="{Binding BuildCommand}" InputGestureText="F7">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Build}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.run}" Command="{Binding RunCommand}" InputGestureText="F5">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Run}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.pause}" Command="{Binding PauseCommand}" InputGestureText="F6"/>
                        <MenuItem Header="{svc:Tr cmd.reset}" Command="{Binding StopCommand}" InputGestureText="Shift+F5"/>
                        <Separator/>
                        <MenuItem Header="{svc:Tr cmd.stepInto}" Command="{Binding StepIntoCommand}" InputGestureText="F11"/>
                        <MenuItem Header="{svc:Tr cmd.stepOver}" Command="{Binding StepOverCommand}" InputGestureText="F10"/>
                        <MenuItem Header="{svc:Tr cmd.stepBack}" Command="{Binding StepBackCommand}" InputGestureText="Shift+F11"/>
                        <MenuItem Header="{svc:Tr cmd.runToCursor}" Command="{Binding RunToCursorCommand}" InputGestureText="Ctrl+F10"/>
                        <Separator/>
                        <MenuItem Header="{svc:Tr cmd.toggleBreakpoint}" Command="{Binding ToggleBreakpointCommand}" InputGestureText="F9"/>
                        <MenuItem Header="{svc:Tr cmd.clearBreakpoints}" Command="{Binding ClearBreakpointsCommand}"/>
                    </MenuItem>
                    <MenuItem Header="{svc:Tr menu.examples}" ItemsSource="{Binding Examples}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Name}"/>
                                <Setter Property="Command" Value="{Binding DataContext.OpenExampleCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Setter Property="CommandParameter" Value="{Binding Path}"/>
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="{svc:Tr menu.view}">
                        <MenuItem Header="{svc:Tr cmd.toggleTheme}" Command="{Binding ToggleThemeCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Moon}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.visualizer}" Click="OnVisualizerClick" InputGestureText="F12">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Chip}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.settings}" Click="OnSettingsClick">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Settings}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.floatScreen}" Click="OnFloatScreenClick">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Screen}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{svc:Tr menu.tools}">
                        <MenuItem Header="{svc:Tr cmd.converter}" Click="OnConverterClick">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Build}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.asciiTable}" Click="OnAsciiClick">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Keyboard}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="{svc:Tr menu.help}">
                        <MenuItem Header="{svc:Tr cmd.reference}" Click="OnReferenceClick">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Book}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.checkUpdates}" Click="OnCheckUpdatesClick">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Export}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{svc:Tr cmd.about}" Command="{Binding AboutCommand}">
                            <MenuItem.Icon><Path Data="{StaticResource Icon.Help}" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>

                <TextBlock Grid.ColumnSpan="4" Text="{Binding ProjectName}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fg.Secondary}" IsHitTestVisible="False"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick">
                        <Path Data="{StaticResource Icon.Minimize}" Style="{StaticResource Icon}" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeClick">
                        <Path x:Name="MaximizeIcon" Data="{StaticResource Icon.Maximize}" Style="{StaticResource Icon}" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick">
                        <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="11" Height="11"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===================== Toolbar ===================== -->
            <Border Grid.Row="1" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1">
                <DockPanel Margin="8,0" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolButton}" Command="{Binding NewProjectCommand}" ToolTip="{svc:Tr cmd.newProject}">
                            <Path Data="{StaticResource Icon.Project}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding OpenProjectCommand}" ToolTip="{svc:Tr cmd.openProject}">
                            <Path Data="{StaticResource Icon.Folder}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding SaveAllCommand}" ToolTip="{svc:Tr cmd.saveAll}">
                            <Path Data="{StaticResource Icon.Save}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Border Style="{StaticResource Divider}"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding BuildCommand}" ToolTip="{svc:Tr cmd.build}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Build}" Style="{StaticResource Icon}"/>
                                <TextBlock Text="{svc:Tr tool.build}" Margin="6,0,2,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding RunCommand}" ToolTip="{svc:Tr cmd.run}" Padding="12,5" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Run}" Style="{StaticResource IconFilled}" Width="12" Height="12" Stroke="White"/>
                                <TextBlock Text="{svc:Tr tool.run}" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding PauseCommand}" ToolTip="{svc:Tr cmd.pause}">
                            <Path Data="{StaticResource Icon.Pause}" Style="{StaticResource Icon}" StrokeThickness="3"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding StopCommand}" ToolTip="{svc:Tr cmd.reset}">
                            <Path Data="{StaticResource Icon.Reset}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Border Style="{StaticResource Divider}"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding StepBackCommand}" ToolTip="{svc:Tr cmd.stepBack}">
                            <Path Data="{StaticResource Icon.StepBack}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding StepIntoCommand}" ToolTip="{svc:Tr cmd.stepInto}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.StepInto}" Style="{StaticResource Icon}"/>
                                <TextBlock Text="{svc:Tr tool.step}" Margin="6,0,2,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding StepOverCommand}" ToolTip="{svc:Tr cmd.stepOver}">
                            <Path Data="{StaticResource Icon.StepOver}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding RunToCursorCommand}" ToolTip="{svc:Tr cmd.runToCursor}">
                            <Path Data="{StaticResource Icon.RunToCursor}" Style="{StaticResource Icon}"/>
                        </Button>
                        <Border Style="{StaticResource Divider}"/>
                        <Button Style="{StaticResource ToolButton}" Click="OnVisualizerClick" ToolTip="{svc:Tr cmd.visualizer}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Chip}" Style="{StaticResource Icon}"/>
                                <TextBlock Text="{svc:Tr tool.visualizer}" Margin="6,0,2,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Text="{svc:Tr tool.speed}" Foreground="{DynamicResource Fg.Secondary}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                        <Slider Width="120" Minimum="0" Maximum="1000" Value="{Binding StepDelay}" IsDirectionReversed="True"
                                IsSnapToTickEnabled="True" Ticks="0,1,5,10,25,50,100,200,400,700,1000" VerticalAlignment="Center"
                                ToolTip="{svc:Tr tool.speedTip}"/>
                        <TextBlock Text="{Binding SpeedText}" Foreground="{DynamicResource Fg.Muted}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="70"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Globe}" Style="{StaticResource Icon}" Stroke="{DynamicResource Fg.Secondary}" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" DisplayMemberPath="Name"
                                  Width="120" ToolTip="{svc:Tr tool.language}"/>
                        <CheckBox Style="{StaticResource ThemeSwitch}" IsChecked="{Binding IsDarkTheme}" Margin="14,0,8,0"
                                  VerticalAlignment="Center" ToolTip="{svc:Tr cmd.toggleTheme}"/>
                        <Button Style="{StaticResource ToolButton}" Click="OnSettingsClick" ToolTip="{svc:Tr cmd.settings}">
                            <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Icon}"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===================== Main content ===================== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" MinWidth="140"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="500" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- Project explorer -->
                <DockPanel Background="{DynamicResource Bg.Panel}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,2,4,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding NewFileCommand}" ToolTip="{svc:Tr cmd.newFile}" Padding="5,3">
                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource Icon}" Width="13" Height="13"/>
                        </Button>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{svc:Tr panel.explorer}"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,2,10,6">
                        <Path Data="{StaticResource Icon.Project}" Style="{StaticResource Icon}" Stroke="{DynamicResource Accent}" Width="15" Height="15"/>
                        <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ListBox x:Name="ProjectList" ItemsSource="{Binding ProjectFiles}" Margin="6,0" MouseDoubleClick="OnProjectFileDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Path}">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{svc:Tr cmd.openFile}"
                                                      Command="{Binding PlacementTarget.Tag.OpenProjectFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="{svc:Tr cmd.setMain}"
                                                      Command="{Binding PlacementTarget.Tag.SetMainFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <StackPanel.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </StackPanel.Tag>
                                    <Path Data="{StaticResource Icon.File}" Style="{StaticResource Icon}" Width="14" Height="14"
                                          Stroke="{DynamicResource Fg.Secondary}"/>
                                    <TextBlock Text="{Binding Name}" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Visibility="{Binding IsMain, Converter={StaticResource BoolToVis}}" Background="{DynamicResource Accent.Soft}"
                                            CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{svc:Tr explorer.main}" FontSize="10" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" Margin="-2,0" HorizontalAlignment="Stretch" Background="Transparent"/>
                <Border Grid.Column="1" Background="{DynamicResource Border}" IsHitTestVisible="False"/>

                <!-- Editor + errors/output -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="190" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <Grid Background="{DynamicResource Bg.Editor}">
                        <TabControl x:Name="DocumentTabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                                    Background="{DynamicResource Bg.Panel}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.File}" Style="{StaticResource Icon}" Width="13" Height="13"/>
                                        <TextBlock Text="{Binding Title}" Margin="6,0,6,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource ToolButton}" Padding="3" Margin="0"
                                                Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="9" Height="9"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <views:EditorView/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedDocument, Converter={StaticResource InvNullToVis}}">
                            <Image Source="/Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{svc:Tr empty.title}" FontSize="18" Margin="0,14,0,6" HorizontalAlignment="Center"/>
                            <TextBlock Text="{svc:Tr empty.hint}" Foreground="{DynamicResource Fg.Secondary}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource AccentButton}" Command="{Binding NewProjectCommand}" Content="{svc:Tr cmd.newProject}" Margin="4"/>
                                <Button Command="{Binding OpenProjectCommand}" Content="{svc:Tr cmd.openProject}" Margin="4"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Row="1" Height="5" Margin="0,-2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
                    <Border Grid.Row="1" Background="{DynamicResource Border}" IsHitTestVisible="False"/>

                    <TabControl Grid.Row="2" x:Name="BottomTabs" Background="{DynamicResource Bg.Panel}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{svc:Tr panel.errors}"/>
                                    <Border Background="{DynamicResource Error}" CornerRadius="7" Padding="5,0" Margin="6,0,0,0"
                                            Visibility="{Binding Diagnostics.Count, Converter={StaticResource CountToVis}}">
                                        <TextBlock Text="{Binding Diagnostics.Count}" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <ListBox ItemsSource="{Binding Diagnostics}" Margin="4" MouseDoubleClick="OnDiagnosticDoubleClick"
                                     Background="{DynamicResource Bg.Panel}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{Binding IsError, Converter={StaticResource SeverityIcon}}" Style="{StaticResource Icon}"
                                                  Stroke="{Binding IsError, Converter={StaticResource StatusBrush}}" Width="14" Height="14"/>
                                            <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Fg.Muted}" MinWidth="70">
                                                <Run Text="{svc:Tr errors.line}"/> <Run Text="{Binding Line, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Message}" Margin="4,0,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="{svc:Tr panel.output}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource ToolButton}" Margin="4"
                                        Command="{Binding ClearOutputCommand}" ToolTip="{svc:Tr cmd.clearOutput}">
                                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="11" Height="11"/>
                                </Button>
                                <ListBox x:Name="OutputList" ItemsSource="{Binding Output}" Margin="4" Background="{DynamicResource Bg.Panel}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Fg.Muted}" Style="{StaticResource Mono}"/>
                                                <TextBlock Text="{Binding Text}" Margin="10,0,0,0" TextWrapping="Wrap"
                                                           Foreground="{Binding Kind, Converter={StaticResource StatusBrush}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>

                <GridSplitter Grid.Column="3" Width="5" Margin="-2,0" HorizontalAlignment="Stretch" Background="Transparent"/>
                <Border Grid.Column="3" Background="{DynamicResource Border}" IsHitTestVisible="False"/>

                <!-- Debug panels -->
                <Grid Grid.Column="4" Background="{DynamicResource Bg.Panel}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{svc:Tr panel.registers}"/>
                        <ItemsControl ItemsSource="{Binding Registers}" Margin="8,0,8,2" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,2" ToolTip="{Binding Decimal}">
                                        <TextBlock Text="{Binding Name}" Width="24" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Fg.Secondary}" Style="{StaticResource Mono}"/>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Splittable, Converter={StaticResource BoolToVis}}">
                                            <TextBox Style="{StaticResource RegisterBox}" Text="{Binding High, UpdateSourceTrigger=LostFocus}" Width="34"
                                                     KeyDown="OnRegisterKeyDown"/>
                                            <TextBox Style="{StaticResource RegisterBox}" Text="{Binding Low, UpdateSourceTrigger=LostFocus}" Width="34"
                                                     KeyDown="OnRegisterKeyDown"/>
                                        </StackPanel>
                                        <TextBox Style="{StaticResource RegisterBox}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Width="70"
                                                 KeyDown="OnRegisterKeyDown"
                                                 Visibility="{Binding Splittable, Converter={StaticResource InvBoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource PanelTitle}" Text="{svc:Tr panel.flags}" Margin="10,6,10,2"/>
                        <ItemsControl ItemsSource="{Binding Flags}" Margin="10,0,10,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Value}" Margin="0,2,12,2"
                                              ToolTip="{Binding DescriptionKey, Converter={StaticResource LocKey}}">
                                        <TextBlock Text="{Binding Name}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Changed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Changed}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Background="{DynamicResource Border}"/>
                    </StackPanel>

                    <TabControl Grid.Row="1" x:Name="DebugTabs">
                        <TabItem x:Name="ScreenTab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Screen}" Style="{StaticResource Icon}" Width="13" Height="13"/>
                                    <TextBlock Text="{svc:Tr panel.screen}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid x:Name="ScreenHost" Background="Black">
                                <ctl:ScreenView x:Name="Screen"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{svc:Tr panel.memory}" x:Name="MemoryTab">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                                    <TextBox x:Name="MemoryAddress" Width="110" Style="{StaticResource MonoBox}" Text="0700:0100" KeyDown="OnMemoryAddressKeyDown"/>
                                    <Button Content="{svc:Tr memory.go}" Margin="6,0,0,0" Padding="10,3" Click="OnMemoryGoClick"/>
                                    <Button Content="CS:IP" Margin="6,0,0,0" Padding="8,3" Click="OnMemoryPresetClick" Tag="CS"/>
                                    <Button Content="DS:0" Margin="4,0,0,0" Padding="8,3" Click="OnMemoryPresetClick" Tag="DS"/>
                                    <Button Content="SS:SP" Margin="4,0,0,0" Padding="8,3" Click="OnMemoryPresetClick" Tag="SS"/>
                                    <Button Content="B800:0" Margin="4,0,0,0" Padding="8,3" Click="OnMemoryPresetClick" Tag="VIDEO"/>
                                </StackPanel>
                                <ScrollBar DockPanel.Dock="Right" x:Name="MemoryScroll" Orientation="Vertical" Minimum="0" Maximum="65520"
                                           SmallChange="16" LargeChange="256" Value="{Binding Offset, ElementName=Hex, Mode=TwoWay}"/>
                                <ctl:HexView x:Name="Hex"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{svc:Tr panel.stack}">
                            <ListBox ItemsSource="{Binding Stack}" Margin="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Mono}" Foreground="{DynamicResource Fg.Muted}" Width="90"/>
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Mono}"/>
                                            <TextBlock Text="{svc:Tr stack.top}" Margin="12,0,0,0" Foreground="{DynamicResource Accent}"
                                                       Visibility="{Binding IsTop, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="{svc:Tr panel.disassembly}">
                            <ListBox ItemsSource="{Binding Disassembly}" Margin="6">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="86"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Breakpoint}"
                                                     Visibility="{Binding HasBreakpoint, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding AddressText}" Style="{StaticResource Mono}" Foreground="{DynamicResource Fg.Muted}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Bytes}" Style="{StaticResource Mono}" Foreground="{DynamicResource Fg.Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="{svc:Tr panel.variables}">
                            <Grid>
                                <ListBox ItemsSource="{Binding Variables}" Margin="6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Type}" Margin="8,0,0,0" Foreground="{DynamicResource Syntax.Directive}" Style="{StaticResource Mono}"/>
                                                    <TextBlock Text="{Binding Address}" Margin="8,0,0,0" Foreground="{DynamicResource Fg.Muted}" Style="{StaticResource Mono}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{svc:Tr variables.empty}" Foreground="{DynamicResource Fg.Muted}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="{Binding Variables.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{svc:Tr panel.devices}" x:Name="DevicesTab">
                            <ScrollViewer x:Name="DevicesScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DevicesPanel" Margin="10,6,10,10"/>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>

            <!-- ===================== Status bar ===================== -->
            <Border Grid.Row="3" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource StatusBrush}}"/>
                        <TextBlock Text="{Binding StateText}" Margin="7,0,16,0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Fg.Secondary}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource Fg.Muted}"/>
                    <TextBlock Text="{Binding PositionText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource Fg.Secondary}" Style="{StaticResource Mono}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
